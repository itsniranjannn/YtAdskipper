<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AdSkipperYT" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand Theme Roles (Hush Midnight & Violet) -->
        <item name="colorPrimary">@color/color_violet</item>
        <item name="colorPrimaryVariant">@color/accent_pressed</item>
        <item name="colorOnPrimary">@color/color_midnight</item>
        <item name="colorSecondary">@color/color_violet</item>
        <item name="colorOnSecondary">@color/color_midnight</item>
        <item name="colorSurface">@color/color_ultramarine</item>
        <item name="colorOnSurface">@color/color_blush</item>
        <item name="android:colorBackground">@color/color_midnight</item>
        <item name="colorOnBackground">@color/color_blush</item>

        <!-- Edge-to-Edge System Bars -->
        <item name="android:windowBackground">@color/color_midnight</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Default font family -->
        <item name="fontFamily">@font/font_inter</item>

        <!-- Switch Style -->
        <item name="switchStyle">@style/Widget.Hush.Switch</item>
    </style>

    <!-- Splash Screen Theme (Android 12+ and core-splashscreen) -->
    <style name="Theme.Hush.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_launch_mark</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.AdSkipperYT</item>
    </style>

    <!-- Typography Scale Styles -->
    <style name="TextAppearance.Hush.Display" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">@font/font_archivo_black</item>
        <item name="android:fontFamily">@font/font_archivo_black</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">@color/color_blush</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Hush.Wordmark" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">@font/font_archivo_black</item>
        <item name="android:fontFamily">@font/font_archivo_black</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/color_blush</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Hush.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/font_inter</item>
        <item name="android:fontFamily">@font/font_inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/color_blush</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Hush.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/font_inter</item>
        <item name="android:fontFamily">@font/font_inter</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineHeight" tools:targetApi="p">22sp</item>
        <item name="android:lineSpacingExtra">7dp</item>
        <item name="android:textColor">@color/color_blush_70</item>
    </style>

    <style name="TextAppearance.Hush.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="fontFamily">@font/font_inter</item>
        <item name="android:fontFamily">@font/font_inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_blush_70</item>
    </style>

    <style name="TextAppearance.Hush.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="fontFamily">@font/font_inter</item>
        <item name="android:fontFamily">@font/font_inter</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/color_blush_70</item>
    </style>

    <!-- Custom Switch Widget Style -->
    <style name="Widget.Hush.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="thumbTint">@color/switch_thumb_selector</item>
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="useMaterialThemeColors">false</item>
    </style>
</resources>
