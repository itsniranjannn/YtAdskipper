<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Amber-to-pink hero fill (matches the logo) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:startColor="#FFA24A"
                android:endColor="#FF2E7E"
                android:angle="315" />
        </shape>
    </item>
    <!-- Faint Blush highlight at the top edge -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:startColor="#40F4E7F1"
                android:endColor="#00F4E7F1"
                android:angle="270" />
            <size android:height="60dp" />
        </shape>
    </item>
</layer-list>
