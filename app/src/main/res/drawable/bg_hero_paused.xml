<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="@color/color_ultramarine" />
            <stroke
                android:width="1dp"
                android:color="@color/color_hairline" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="31dp"
                android:topRightRadius="31dp"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
            <gradient
                android:startColor="#20F4E7F1"
                android:endColor="#00F4E7F1"
                android:angle="270" />
            <size android:height="50dp" />
        </shape>
    </item>
</layer-list>
